PORT=3000
APP_URL=http://localhost:3000
# Set a long private first-account setup code. Required to create the owner.
SETUP_CODE=replace-with-a-long-random-private-code
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this exact key permanently to decrypt linked Google tokens.
ENCRYPTION_KEY=
DATA_DIR=./data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
